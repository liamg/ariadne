# Frozen test configuration.
#
# Every value here is part of the contract that makes two results comparable.
# Change one and results recorded before the change no longer mean the same
# thing as results after it. Treat this exactly like bench's position list:
# change it deliberately, and never silently.

# ---- harness ---------------------------------------------------------------

FASTCHESS_VERSION=v1.8.2-alpha

# The book is mounted at /books inside the container. Provisional until the
# generated CC0 book lands - see `make book`.
BOOK=/books/book.epd

# ---- engine settings applied to BOTH sides ---------------------------------

HASH_MB=16
MOVE_OVERHEAD_MS=50

# Fixed so opening order is reproducible across runs.
SRAND=1

# ---- smoke: the PR canary --------------------------------------------------
#
# Fixed nodes, not a time control. That makes it deterministic, so a noisy
# shared CI runner cannot manufacture a spurious time loss. This is a smoke
# test, NOT a statistical one: it catches crashes, illegal moves, hangs and
# outright disasters. It cannot detect -30 Elo and must never be read as
# evidence a change is good.

SMOKE_NODES=100000
SMOKE_ROUNDS=15
SMOKE_MIN_SCORE_PCT=20

# ---- fast: short-TC regression check ---------------------------------------
#
# Bounds say "prove this isn't a serious regression", not "prove this helps".

FAST_TC=8+0.08
FAST_ELO0=-15
FAST_ELO1=0
FAST_MAX_ROUNDS=1500

# ---- proper: the real thing ------------------------------------------------

PROPER_TC=10+0.1
PROPER_ELO0=0
PROPER_ELO1=10
PROPER_MAX_ROUNDS=20000

# ---- non-regression bounds for simplifications -----------------------------
#
# Use with MODE=proper SIMPLIFY=1: "prove removing this doesn't cost anything".

SIMPLIFY_ELO0=-5
SIMPLIFY_ELO1=0

# ---- shared -----------------------------------------------------------------

ALPHA=0.05
BETA=0.05

# SPRT elo model. fastchess defaults to `normalized` (nElo); the conventional
# [0,5] style bounds are quoted in logistic Elo, so we pin logistic explicitly.
SPRT_MODEL=logistic
